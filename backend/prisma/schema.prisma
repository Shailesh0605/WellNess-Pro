datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  Int      @id @default(autoincrement())
  email               String   @unique
  password            String
  name                String?
  age                 Int?
  gender              String?
  height              Float?
  weight              Float?
  activityLevel       String?
  fitnessGoal         String?
  medicalConditions   String?
  dietaryPreferences  String?
  profilePhoto        String?
  workouts            Workout[]
  workoutLogs         WorkoutLog[]
  nutritionLogs       NutritionLog[]
  customFoods         CustomFood[]
  sessions            Session[]
  tokenVersion        Int      @default(0)
  lastLogin           DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model Workout {
  id        Int      @id @default(autoincrement())
  title     String
  notes     String?
  date      DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model Session {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id])
  refreshTokenHash String
  userAgent        String?
  ip               String?
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime?
  expiresAt        DateTime
  isRevoked        Boolean  @default(false)

  @@index([userId])
  @@index([refreshTokenHash])
}

// WorkoutLog stores detailed per-user workout/progress entries.
model WorkoutLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  // arbitrary workout details (category, exercises array, duration, calories, sets, reps, intensity, notes etc.)
  data      Json
  // timestamp when workout occurred (can be date+time)
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

// NutritionLog stores per-user nutrition entries (food, quantity, nutrition values)
model NutritionLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  data      Json
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

// CustomFood stores user-added foods which can be persisted per-user.
model CustomFood {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  calories  Int      @default(0)
  protein   Int      @default(0)
  carbs     Int      @default(0)
  fat       Int      @default(0)
  type      String   @default("Snack")
  emoji     String?
  createdAt DateTime @default(now())

  @@index([userId])
}
