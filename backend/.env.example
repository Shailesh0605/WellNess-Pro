# Backend example env (copy to backend/.env)
PORT=4000
DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET=replace_with_a_random_32_byte_secret
REFRESH_TOKEN_SECRET=replace_with_a_different_random_32_byte_secret
# Set FRONTEND_URL to the URL where your Next frontend is served (used for CORS)
FRONTEND_URL=http://localhost:3000
# Optional: YouTube API key for youtube route
YOUTUBE_API_KEY=
